@@ -0,0 +1,161 @@
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from benchmarks.baselines import attemory as semble_eval
+from benchmarks.baselines import attemory_common as semble_common
+from benchmarks.baselines import attemory_index as semble_index
+
+
+def test_compatible_patterns_preserve_source_scope() -> None:
+    patterns = semble_common.compatible_include_patterns()
+
+    assert "*.py" in patterns
+    assert "**/*.py" in patterns
+    assert "CMakeLists.txt" in patterns
+    assert "**/CMakeLists.txt" in patterns
+    assert "*.md" not in patterns
+
+
+def test_compatible_config_uses_repository_search_defaults(tmp_path: Path) -> None:
+    config = semble_index.build_config(
+        tmp_path,
+        repo="click",
+        revision="a" * 40,
+        host="127.0.0.1",
+        port=9006,
+        profile="compatible",
+    )
+
+    assert config.session_id == f"attemory-semble-atcode-click-{'a' * 12}"
+    assert config.kv_persist is True
+    assert config.chunk_lines == 30
+    assert config.blank_line_window == 10
+    assert config.file_boundary_reserve_percent == 25
+    assert config.candidate_chunk_top_k == 20
+    assert "*.py" in config.include_patterns
+    assert "*.md" not in config.include_patterns
+
+
+def test_multisegment_candidates_are_reranked_and_fused() -> None:
+    records = {
+        "a": SimpleNamespace(file="src/a.py"),
+        "b": SimpleNamespace(file="src/b.py"),
+        "c": SimpleNamespace(file="src/a.py"),
+    }
+    initial = [
+        SimpleNamespace(id="a", text="A", segment_id=0),
+        SimpleNamespace(id="b", text="B", segment_id=1),
+        SimpleNamespace(id="c", text="C", segment_id=1),
+    ]
+    reranked = [
+        SimpleNamespace(id="b", text="B", segment_id=0),
+        SimpleNamespace(id="c", text="C", segment_id=0),
+        SimpleNamespace(id="a", text="A", segment_id=0),
+    ]
+
+    class FakeClient:
+        def search(self, *_args, **_kwargs):
+            return initial
+
+        def oneshot_search(self, *_args, **_kwargs):
+            return reranked
+
+    index = semble_eval.IndexInfo(
+        root=Path("/repo"),
+        session_id="session",
+        file_count=2,
+        chunk_count=3,
+        token_count=100,
+        segment_count=2,
+        memory_map=records,
+    )
+
+    outcome = semble_eval.search_repo(
+        "where is b",
+        index=index,
+        client=FakeClient(),
+        search_top_k=3,
+        top_k=2,
+        aggregation="sum",
+        oneshot_rerank=True,
+    )
+
+    assert outcome.files == ["src/a.py", "src/b.py"]
+    assert outcome.raw_segment_count == 2
+    assert outcome.oneshot_passes == 1
+
+
+def test_result_resume_rejects_different_parameters(tmp_path: Path) -> None:
+    path = tmp_path / "results.json"
+    path.write_text(
+        json.dumps(
+            {
+                "run_config": {
+                    "top_k": 10,
+                    "search_top_k": 20,
+                    "latency_runs": 1,
+                    "file_aggregation": "sum",
+                    "oneshot_rerank": True,
+                },
+                "repos": [],
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    with pytest.raises(RuntimeError, match="different benchmark parameters"):
+        semble_eval.load_completed(
+            path,
+            run_config={
+                "top_k": 10,
+                "search_top_k": 50,
+                "latency_runs": 1,
+                "file_aggregation": "sum",
+                "oneshot_rerank": True,
+            },
+        )
+
+
+def test_ndcg_matches_binary_file_metric() -> None:
+    score = semble_common.ndcg_at_k([1, 3], n_relevant=2, k=10)
+    expected = (1.0 + 1.0 / math.log2(4)) / (
+        1.0 + 1.0 / math.log2(3)
+    )
+
+    assert score == pytest.approx(expected)
+
+
+def test_manifest_entry_must_match_loaded_index() -> None:
+    index = semble_eval.IndexInfo(
+        root=Path("/repo"),
+        session_id="session-a",
+        file_count=1,
+        chunk_count=2,
+        token_count=100,
+        segment_count=1,
+        memory_map={},
+    )
+    spec = SimpleNamespace(revision="a" * 40)
+    manifest = {
+        "repos": {
+            "click": {
+                "revision": "a" * 40,
+                "session_id": "session-b",
+                "chunk_count": 2,
+            }
+        }
+    }
+
+    with pytest.raises(RuntimeError, match="session mismatch"):
+        semble_eval.validate_manifest_entry(
+            repo="click",
+            spec=spec,
+            index=index,
+            manifest=manifest,
+        )
