+from __future__ import annotations
+
+import importlib.util
+import json
+import math
+import os
+import sys
+from pathlib import Path
+from types import ModuleType
+from typing import Any, Iterable, Mapping
+
+
+DEFAULT_SEMBLE_ROOT = Path(__file__).resolve().parents[2]
+ATTEMORY_ROOT = Path(
+    os.environ.get("ATTEMORY_ROOT", DEFAULT_SEMBLE_ROOT.parents[1])
+).expanduser().resolve()
+DEFAULT_INDEX_MANIFEST = (
+    Path.home() / ".cache" / "attemory-semble-atcode" / "index-manifest.json"
+)
+DEFAULT_RESULTS = DEFAULT_SEMBLE_ROOT / "output" / "attemory-code.json"
+DEFAULT_BASELINE_RESULTS = (
+    ATTEMORY_ROOT / "benchmarks" / "results" / "semble" / "attemory.json"
+)
+
+SEARCH_SYSTEM_PROMPT = (
+    "Read the following code carefully and find the most relevant code to the query."
+)
+RERANK_SYSTEM_PROMPT = (
+    "Rank the selected code snippets by how directly they answer the query. Prefer snippets "
+    "that contain the requested source implementation or definition. Prefer production source "
+    "over tests, examples, documentation, and generated files unless the query explicitly asks "
+    "for them."
+)
+QUERY_CONTEXT_PROMPT = (
+    "Read the selected code snippets carefully and answer the user's query: {question}. "
+    "Treat the query as code navigation. Rank snippets by how directly they define, declare, "
+    "implement, export, or explain the requested symbol, API, behavior, or feature. Prefer exact "
+    "identifier matches and concrete implementation or definition code over snippets that only "
+    "mention, call, wrap, test, or document it. Prefer production source over tests, examples, "
+    "documentation, and generated files unless the query explicitly asks for them."
+)
+
+# This is the source-file scope used by the published Attemory/Semble run. The
+# new benchmark keeps that scope so the result isolates attemory code's chunking,
+# segment planning, persistence, and metadata rather than adding documentation
+# and configuration files at the same time.
+SEMBLE_CODE_SUFFIXES = {
+    ".bash",
+    ".c",
+    ".cc",
+    ".cmake",
+    ".cpp",
+    ".cs",
+    ".css",
+    ".cts",
+    ".cxx",
+    ".ex",
+    ".exs",
+    ".go",
+    ".h",
+    ".hh",
+    ".hpp",
+    ".hs",
+    ".htm",
+    ".html",
+    ".hxx",
+    ".java",
+    ".js",
+    ".jsx",
+    ".kt",
+    ".kts",
+    ".less",
+    ".lhs",
+    ".lua",
+    ".mjs",
+    ".mts",
+    ".php",
+    ".py",
+    ".pyi",
+    ".rb",
+    ".rs",
+    ".sass",
+    ".sc",
+    ".scala",
+    ".scss",
+    ".sh",
+    ".svelte",
+    ".swift",
+    ".ts",
+    ".tsx",
+    ".vue",
+    ".zig",
+}
+SEMBLE_SPECIAL_FILENAMES = {"CMakeLists.txt"}
+
+
+def compatible_include_patterns() -> list[str]:
+    patterns = [
+        pattern
+        for suffix in sorted(SEMBLE_CODE_SUFFIXES)
+        for pattern in (f"*{suffix}", f"**/*{suffix}")
+    ]
+    patterns.extend(sorted(SEMBLE_SPECIAL_FILENAMES))
+    patterns.extend(f"**/{name}" for name in sorted(SEMBLE_SPECIAL_FILENAMES))
+    return patterns
+
+
+def import_attemory() -> None:
+    try:
+        import attemory  # noqa: F401
+    except ModuleNotFoundError:
+        python_root = ATTEMORY_ROOT / "python"
+        if str(python_root) not in sys.path:
+            sys.path.insert(0, str(python_root))
+        import attemory  # noqa: F401
+
+
+def load_semble_data(semble_root: Path) -> ModuleType:
+    data_path = semble_root.resolve() / "benchmarks" / "data.py"
+    if not data_path.is_file():
+        raise RuntimeError(
+            f"Semble benchmark checkout not found at {semble_root}; "
+            "run `cd benchmarks && ./prepare_bench.sh semble` from Attemory"
+        )
+    module_name = "_attemory_semble_upstream_data"
+    spec = importlib.util.spec_from_file_location(module_name, data_path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load Semble benchmark data module: {data_path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def selected_repos(
+    data: ModuleType,
+    *,
+    repos: Iterable[str] | None,
+    languages: Iterable[str] | None,
+) -> tuple[dict[str, Any], dict[str, list[Any]]]:
+    repo_filter = set(repos or ())
+    language_filter = set(languages or ())
+    specs = data.available_repo_specs()
+    tasks = data.load_tasks(repo_specs=specs)
+    tasks = [
+        task
+        for task in tasks
+        if (not repo_filter or task.repo in repo_filter)
+        and (not language_filter or task.language in language_filter)
+    ]
+    if not tasks:
+        raise RuntimeError("no Semble tasks matched the requested filters")
+    grouped = data.grouped_tasks(tasks)
+    return {repo: specs[repo] for repo in grouped}, grouped
+
+
+def git_head(path: Path) -> str:
+    import subprocess
+
+    result = subprocess.run(
+        ["git", "-C", str(path), "rev-parse", "HEAD"],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return result.stdout.strip()
+
+
+def git_dirty(path: Path) -> bool:
+    import subprocess
+
+    result = subprocess.run(
+        ["git", "-C", str(path), "status", "--porcelain"],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return bool(result.stdout.strip())
+
+
+def verify_repo_revision(spec: Any) -> None:
+    actual = git_head(spec.checkout_dir)
+    if actual != spec.revision:
+        raise RuntimeError(
+            f"{spec.name}: checkout revision is {actual}, expected {spec.revision}; "
+            "run the Semble repo sync/check command"
+        )
+
+
+def session_id(repo: str, revision: str) -> str:
+    return f"attemory-semble-atcode-{repo}-{revision[:12]}"
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError(f"expected a JSON object: {path}")
+    return value
+
+
+def write_json_atomic(path: Path, value: Mapping[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(path.name + ".tmp")
+    temporary.write_text(
+        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(path)
+
+
+def path_matches(file_path: str, target_path: str) -> bool:
+    normalized_file = file_path.replace("\\", "/")
+    normalized_target = target_path.replace("\\", "/")
+    return (
+        normalized_file == normalized_target
+        or normalized_file.endswith(f"/{normalized_target}")
+        or normalized_target.endswith(f"/{normalized_file}")
+    )
+
+
+def file_rank(file_paths: list[str], target_path: str) -> int | None:
+    for index, file_path in enumerate(file_paths, 1):
+        if path_matches(file_path, target_path):
+            return index
+    return None
+
+
+def ndcg_at_k(relevant_ranks: list[int], n_relevant: int, k: int) -> float:
+    if n_relevant == 0:
+        return 0.0
+    relevances = [0] * k
+    for rank in relevant_ranks:
+        if 1 <= rank <= k:
+            relevances[rank - 1] = 1
+    ideal_count = min(k, n_relevant)
+    ideal = sum(1.0 / math.log2(index + 2) for index in range(ideal_count))
+    actual = sum(
+        relevance / math.log2(index + 2)
+        for index, relevance in enumerate(relevances)
+    )
+    return actual / ideal if ideal else 0.0
diff --git a/benchmarks/baselines/attemory_index.py b/benchmarks/baselines/attemory_index.py
new file mode 100644
index 0000000..bd27af9
--- /dev/null
+++ b/benchmarks/baselines/attemory_index.py
@@ -0,0 +1,270 @@
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+from dataclasses import replace
+from pathlib import Path
+from typing import Any
+
+from benchmarks.baselines.attemory_common import (
+    ATTEMORY_ROOT,
+    DEFAULT_INDEX_MANIFEST,
+    DEFAULT_SEMBLE_ROOT,
+    compatible_include_patterns,
+    git_dirty,
+    import_attemory,
+    load_semble_data,
+    selected_repos,
+    session_id,
+    git_head,
+    verify_repo_revision,
+    write_json_atomic,
+)
+
+
+def build_config(
+    root: Path,
+    *,
+    repo: str,
+    revision: str,
+    host: str,
+    port: int,
+    profile: str,
+) -> Any:
+    import_attemory()
+    from attemory.code.project import default_config
+
+    config = default_config(root, session_id(repo, revision))
+    config = replace(
+        config,
+        host=host,
+        port=port,
+        display_top_k=10,
+        candidate_chunk_top_k=20,
+    )
+    if profile == "compatible":
+        config = replace(config, include_patterns=compatible_include_patterns())
+    return config
+
+
+def ensure_config(root: Path, expected: Any, *, allow_replace: bool) -> None:
+    import_attemory()
+    from attemory.code.project import config_path, load_config, write_config
+
+    path = config_path(root)
+    if not path.exists():
+        write_config(root, expected)
+        return
+    current = load_config(root)
+    if current == expected:
+        return
+    if not allow_replace:
+        raise RuntimeError(
+            f"{root}: existing .attemory/config.toml differs from the benchmark "
+            "configuration; use --reindex to replace it explicitly"
+        )
+    write_config(root, expected)
+
+
+def run_attemory_code(root: Path, command: list[str]) -> subprocess.CompletedProcess[str]:
+    env = os.environ.copy()
+    python_root = str(ATTEMORY_ROOT / "python")
+    env["PYTHONPATH"] = (
+        python_root
+        if not env.get("PYTHONPATH")
+        else python_root + os.pathsep + env["PYTHONPATH"]
+    )
+    console_script = Path(sys.executable).with_name("atcode")
+    if console_script.is_file():
+        argv = [str(console_script), *command]
+        cwd = root
+    else:
+        # Import Attemory before changing into the indexed repository. Some
+        # source roots contain modules such as types.py that would otherwise
+        # shadow Python's standard library during interpreter startup.
+        runner = (
+            "import os,sys; "
+            "from attemory.code.cli import main; "
+            "os.chdir(sys.argv[1]); "
+            "raise SystemExit(main(sys.argv[2:]))"
+        )
+        argv = [sys.executable, "-c", runner, str(root), *command]
+        cwd = ATTEMORY_ROOT
+    completed = subprocess.run(
+        argv,
+        cwd=cwd,
+        env=env,
+        check=False,
+        text=True,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            f"{root}: `attemory code {' '.join(command)}` failed "
+            f"with exit code {completed.returncode}"
+        )
+    return completed
+
+
+def load_manifest(path: Path) -> dict[str, Any]:
+    if not path.is_file():
+        return {"schema_version": 1, "repos": {}}
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict) or not isinstance(value.get("repos"), dict):
+        raise RuntimeError(f"invalid index manifest: {path}")
+    return value
+
+
+def index_metadata(root: Path) -> dict[str, Any]:
+    import_attemory()
+    from attemory.code.project import index_path, load_index
+
+    path = index_path(root)
+    if not path.is_file():
+        raise RuntimeError(f"attemory code did not write index metadata: {path}")
+    return load_index(root)
+
+
+def scan_config(root: Path, config: Any) -> tuple[int, int]:
+    import_attemory()
+    from attemory.code.project import scan_summary
+
+    summary = scan_summary(root, config)
+    return summary.files, summary.chunks
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Build Semble repository indexes through `attemory code index`."
+    )
+    parser.add_argument("--semble-root", type=Path, default=DEFAULT_SEMBLE_ROOT)
+    parser.add_argument("--repo", action="append", default=[])
+    parser.add_argument("--language", action="append", default=[])
+    parser.add_argument("--host", default=os.environ.get("ATTEMORY_HOST", "127.0.0.1"))
+    parser.add_argument(
+        "--port",
+        type=int,
+        default=int(os.environ.get("ATTEMORY_PORT", "9006")),
+    )
+    parser.add_argument(
+        "--profile",
+        choices=("compatible", "default"),
+        default="compatible",
+        help="compatible preserves the published run's source-file scope",
+    )
+    parser.add_argument("--manifest", type=Path, default=DEFAULT_INDEX_MANIFEST)
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument("--dry-run", action="store_true")
+    mode.add_argument("--resume", action="store_true")
+    mode.add_argument("--reindex", action="store_true")
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    import_attemory()
+    from attemory import __version__ as attemory_version
+
+    data = load_semble_data(args.semble_root)
+    specs, _ = selected_repos(
+        data,
+        repos=args.repo or None,
+        languages=args.language or None,
+    )
+    manifest = load_manifest(args.manifest.expanduser())
+    manifest.update(
+        {
+            "schema_version": 1,
+            "profile": args.profile,
+            "semble_root": str(args.semble_root.resolve()),
+            "host": args.host,
+            "port": args.port,
+            "attemory_version": attemory_version,
+            "attemory_git_commit": git_head(ATTEMORY_ROOT),
+            "attemory_git_dirty": git_dirty(ATTEMORY_ROOT),
+        }
+    )
+
+    total_files = 0
+    total_chunks = 0
+    for repo, spec in sorted(specs.items()):
+        verify_repo_revision(spec)
+        root = spec.benchmark_dir.resolve()
+        expected = build_config(
+            root,
+            repo=repo,
+            revision=spec.revision,
+            host=args.host,
+            port=args.port,
+            profile=args.profile,
+        )
+
+        if args.dry_run:
+            file_count, chunk_count = scan_config(root, expected)
+            total_files += file_count
+            total_chunks += chunk_count
+            print(
+                f"{repo}: files={file_count} chunks={chunk_count} "
+                f"memories={file_count + chunk_count}"
+            )
+            continue
+
+        ensure_config(root, expected, allow_replace=args.reindex)
+        command = ["reindex", "--force"] if args.reindex else ["index"]
+        if args.resume:
+            command.append("--resume")
+        had_index = (root / ".attemory" / "index.json").is_file()
+        started = time.perf_counter()
+        completed = run_attemory_code(root, command)
+        elapsed_ms = (time.perf_counter() - started) * 1000
+        metadata = index_metadata(root)
+        previous = manifest["repos"].get(repo, {})
+        index_ms = (
+            previous.get("index_ms", 0.0)
+            if had_index and not args.reindex
+            else elapsed_ms
+        )
+        entry = {
+            "repo": repo,
+            "language": spec.language,
+            "revision": spec.revision,
+            "benchmark_root": str(root),
+            "session_id": metadata["session_id"],
+            "profile": args.profile,
+            "chunk_lines": expected.chunk_lines,
+            "blank_line_window": expected.blank_line_window,
+            "file_boundary_reserve_percent": expected.file_boundary_reserve_percent,
+            "file_count": int(metadata["file_count"]),
+            "chunk_count": int(metadata["chunk_count"]),
+            "memory_count": int(metadata["memory_count"]),
+            "token_count": int(metadata["token_count"]),
+            "segment_count": int(metadata["segment_count"]),
+            "index_ms": float(index_ms),
+        }
+        manifest["repos"][repo] = entry
+        write_json_atomic(args.manifest.expanduser(), manifest)
+        total_files += entry["file_count"]
+        total_chunks += entry["chunk_count"]
+        print(
+            f"{repo}: files={entry['file_count']} chunks={entry['chunk_count']} "
+            f"segments={entry['segment_count']} index_ms={entry['index_ms']:.0f}"
+        )
+
+    if args.dry_run:
+        print(
+            f"scan repos={len(specs)} files={total_files} chunks={total_chunks} "
+            f"memories={total_files + total_chunks}"
+        )
+    else:
+        print(
+            f"indexed repos={len(specs)} files={total_files} chunks={total_chunks} "
+            f"manifest={args.manifest.expanduser()}"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
