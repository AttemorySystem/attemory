+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import statistics
+import sys
+import time
+from collections import defaultdict
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any
+
+from benchmarks.baselines.attemory_common import (
+    DEFAULT_INDEX_MANIFEST,
+    DEFAULT_BASELINE_RESULTS,
+    DEFAULT_RESULTS,
+    DEFAULT_SEMBLE_ROOT,
+    QUERY_CONTEXT_PROMPT,
+    RERANK_SYSTEM_PROMPT,
+    file_rank,
+    import_attemory,
+    load_semble_data,
+    ndcg_at_k,
+    selected_repos,
+    verify_repo_revision,
+    write_json_atomic,
+)
+
+
+DEFAULT_TOP_K = 10
+DEFAULT_SEARCH_TOP_K = 20
+FILE_HEADER_PREFIX = "// the following code come from "
+
+
+@dataclass(frozen=True)
+class IndexInfo:
+    root: Path
+    session_id: str
+    file_count: int
+    chunk_count: int
+    token_count: int
+    segment_count: int
+    memory_map: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class RepoResult:
+    repo: str
+    language: str
+    queries: int
+    ndcg10: float
+    p50_ms: float
+    files: int
+    chunks: int
+    tokens: int
+    segments: int
+    index_ms: float
+    multisegment_queries: int
+    oneshot_passes: int
+    by_category: dict[str, float]
+
+
+@dataclass(frozen=True)
+class SearchOutcome:
+    files: list[str]
+    raw_segment_count: int
+    oneshot_passes: int
+
+
+def load_index(root: Path) -> IndexInfo:
+    import_attemory()
+    from attemory.code.project import (
+        CONTEXT_STRUCTURE,
+        chunks_path,
+        index_path,
+        load_chunks,
+        load_config,
+        load_index as load_index_metadata,
+    )
+
+    if not index_path(root).is_file() or not chunks_path(root).is_file():
+        raise RuntimeError(
+            f"{root}: no attemory code index; run "
+            "python -m benchmarks.baselines.attemory_index"
+        )
+    config = load_config(root)
+    metadata = load_index_metadata(root)
+    memory_map = load_chunks(chunks_path(root))
+    if metadata.get("context_structure") != CONTEXT_STRUCTURE:
+        raise RuntimeError(f"{root}: unsupported context structure")
+    if metadata.get("session_id") != config.session_id:
+        raise RuntimeError(f"{root}: config and index session ids differ")
+    if Path(str(metadata.get("repo_root", ""))).resolve() != root.resolve():
+        raise RuntimeError(f"{root}: index metadata points at another repository root")
+    if metadata.get("system_prompt") != (
+        "Read the following code carefully and find the most relevant code to the query."
+    ):
+        raise RuntimeError(f"{root}: index system prompt does not match repository search")
+    if int(metadata.get("chunk_count", -1)) != len(memory_map):
+        raise RuntimeError(f"{root}: chunk metadata count mismatch")
+    if int(metadata.get("memory_count", -1)) != int(metadata["file_count"]) + len(
+        memory_map
+    ):
+        raise RuntimeError(f"{root}: file-header and chunk memory count mismatch")
+    return IndexInfo(
+        root=root,
+        session_id=config.session_id,
+        file_count=int(metadata["file_count"]),
+        chunk_count=len(memory_map),
+        token_count=int(metadata["token_count"]),
+        segment_count=int(metadata["segment_count"]),
+        memory_map=memory_map,
+    )
+
+
+def ordered_chunk_ids(results: list[Any], memory_map: dict[str, Any]) -> list[str]:
+    ordered: list[str] = []
+    seen: set[str] = set()
+    for result in results:
+        memory_id = getattr(result, "id", None)
+        if (
+            isinstance(memory_id, str)
+            and memory_id in memory_map
+            and memory_id not in seen
+        ):
+            seen.add(memory_id)
+            ordered.append(memory_id)
+    return ordered
+
+
+def result_segments(results: list[Any]) -> set[int]:
+    return {
+        segment_id
+        for result in results
+        if isinstance((segment_id := getattr(result, "segment_id", None)), int)
+    }
+
+
+def memories_from_index_order(
+    results: list[Any],
+    memory_map: dict[str, Any],
+) -> list[dict[str, str]]:
+    text_by_id: dict[str, str] = {}
+    for result in results:
+        memory_id = getattr(result, "id", None)
+        text = getattr(result, "text", "") or ""
+        if (
+            isinstance(memory_id, str)
+            and memory_id in memory_map
+            and text
+            and memory_id not in text_by_id
+        ):
+            text_by_id[memory_id] = text
+
+    memories: list[dict[str, str]] = []
+    current_file: str | None = None
+    for memory_id, record in memory_map.items():
+        text = text_by_id.get(memory_id)
+        if text is None:
+            continue
+        if record.file != current_file:
+            memories.append({"text": FILE_HEADER_PREFIX + record.file})
+            current_file = record.file
+        memories.append({"id": memory_id, "text": text})
+    return memories
+
+
+def rerank(
+    *,
+    client: Any,
+    query: str,
+    query_context: str,
+    results: list[Any],
+    ordered_ids: list[str],
+    memory_map: dict[str, Any],
+    search_top_k: int,
+) -> tuple[list[str], int]:
+    current = results
+    pass_count = 0
+    for _ in range(8):
+        if len(result_segments(current)) <= 1:
+            break
+        memories = memories_from_index_order(current, memory_map)
+        if not memories:
+            break
+        header_count = sum(1 for memory in memories if "id" not in memory)
+        current = client.oneshot_search(
+            query,
+            memories,
+            system=RERANK_SYSTEM_PROMPT,
+            query_context=query_context,
+            top_k=min(len(memories), header_count + search_top_k),
+        )
+        pass_count += 1
+        reranked_ids = ordered_chunk_ids(current, memory_map)
+        if reranked_ids:
+            seen = set(reranked_ids)
+            ordered_ids = reranked_ids + [
+                memory_id for memory_id in ordered_ids if memory_id not in seen
+            ]
+    return ordered_ids, pass_count
+
+
+def file_ranking(
+    ordered_ids: list[str],
+    *,
+    index: IndexInfo,
+    search_top_k: int,
+    top_k: int,
+    aggregation: str,
+) -> list[str]:
+    hits: list[str] = []
+    for memory_id in ordered_ids:
+        record = index.memory_map.get(memory_id)
+        if record is None:
+            continue
+        hits.append(record.file)
+        if len(hits) >= search_top_k:
+            break
+
+    scores: dict[str, float] = {}
+    first_rank: dict[str, int] = {}
+    hit_counts: dict[str, int] = {}
+    for rank, file_path in enumerate(hits, 1):
+        count = hit_counts.get(file_path, 0)
+        if aggregation == "first" and count:
+            continue
+        if aggregation == "capped" and count >= 2:
+            continue
+        weight = 0.25 if aggregation == "capped" and count else 1.0
+        scores[file_path] = scores.get(file_path, 0.0) + weight / math.log2(
+            rank + 1
+        )
+        first_rank.setdefault(file_path, rank)
+        hit_counts[file_path] = count + 1
+    return sorted(
+        scores,
+        key=lambda path: (-scores[path], first_rank[path], path),
+    )[:top_k]
+
+
+def search_repo(
+    question: str,
+    *,
+    index: IndexInfo,
+    client: Any,
+    search_top_k: int,
+    top_k: int,
+    aggregation: str,
+    oneshot_rerank: bool,
+) -> SearchOutcome:
+    query = f"Query: {question}"
+    query_context = QUERY_CONTEXT_PROMPT.format(question=question)
+    results = client.search(
+        query,
+        session_id=index.session_id,
+        query_context=query_context,
+        top_k=search_top_k,
+    )
+    ordered_ids = ordered_chunk_ids(results, index.memory_map)
+    raw_segment_count = len(result_segments(results))
+    oneshot_passes = 0
+    if oneshot_rerank and raw_segment_count > 1:
+        ordered_ids, oneshot_passes = rerank(
+            client=client,
+            query=query,
+            query_context=query_context,
+            results=results,
+            ordered_ids=ordered_ids,
+            memory_map=index.memory_map,
+            search_top_k=search_top_k,
+        )
+    return SearchOutcome(
+        files=file_ranking(
+            ordered_ids,
+            index=index,
+            search_top_k=search_top_k,
+            top_k=top_k,
+            aggregation=aggregation,
+        ),
+        raw_segment_count=raw_segment_count,
+        oneshot_passes=oneshot_passes,
+    )
+
+
+def evaluate_repo(
+    tasks: list[Any],
+    *,
+    index: IndexInfo,
+    client: Any,
+    search_top_k: int,
+    top_k: int,
+    aggregation: str,
+    oneshot_rerank: bool,
+    latency_runs: int,
+    verbose: bool,
+) -> tuple[float, float, dict[str, float], int, int]:
+    client.restore_session(index.session_id)
+    scores: list[float] = []
+    latencies: list[float] = []
+    category_scores: dict[str, list[float]] = defaultdict(list)
+    multisegment_queries = 0
+    oneshot_passes = 0
+    for task in tasks:
+        file_paths: list[str] = []
+        query_latencies: list[float] = []
+        task_used_multiple_segments = False
+        for _ in range(latency_runs):
+            started = time.perf_counter()
+            outcome = search_repo(
+                task.query,
+                index=index,
+                client=client,
+                search_top_k=search_top_k,
+                top_k=top_k,
+                aggregation=aggregation,
+                oneshot_rerank=oneshot_rerank,
+            )
+            file_paths = outcome.files
+            if outcome.raw_segment_count > 1:
+                task_used_multiple_segments = True
+            oneshot_passes += outcome.oneshot_passes
+            query_latencies.append((time.perf_counter() - started) * 1000)
+            try:
+                client.clear_cache(index.session_id)
+            except Exception:
+                pass
+        if task_used_multiple_segments:
+            multisegment_queries += 1
+        relevant_ranks = [
+            rank
+            for target in task.all_relevant
+            if (rank := file_rank(file_paths, target.path)) is not None
+        ]
+        score = ndcg_at_k(relevant_ranks, len(task.all_relevant), top_k)
+        scores.append(score)
+        category_scores[task.category].append(score)
+        latencies.append(statistics.median(query_latencies))
+        if verbose:
+            print(
+                f"  ndcg@10={score:.3f} ranks={relevant_ranks} "
+                f"query={task.query!r}",
+                file=sys.stderr,
+            )
+            print(f"    top-5: {file_paths[:5]}", file=sys.stderr)
+    return (
+        sum(scores) / len(scores),
+        statistics.median(latencies),
+        {
+            category: sum(values) / len(values)
+            for category, values in sorted(category_scores.items())
+        },
+        multisegment_queries,
+        oneshot_passes,
+    )
+
+
+def load_index_manifest(path: Path) -> dict[str, Any]:
+    if not path.is_file():
+        raise RuntimeError(
+            f"index manifest not found: {path}; "
+            "run python -m benchmarks.baselines.attemory_index first"
+        )
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict) or not isinstance(value.get("repos"), dict):
+        raise RuntimeError(f"invalid index manifest: {path}")
+    return value
+
+
+def validate_manifest_entry(
+    *,
+    repo: str,
+    spec: Any,
+    index: IndexInfo,
+    manifest: dict[str, Any],
+) -> dict[str, Any]:
+    entry = manifest["repos"].get(repo)
+    if not isinstance(entry, dict):
+        raise RuntimeError(f"{repo}: missing from the index manifest")
+    if entry.get("revision") != spec.revision:
+        raise RuntimeError(f"{repo}: index manifest revision mismatch")
+    if entry.get("session_id") != index.session_id:
+        raise RuntimeError(f"{repo}: index manifest session mismatch")
+    if int(entry.get("chunk_count", -1)) != index.chunk_count:
+        raise RuntimeError(f"{repo}: index manifest chunk count mismatch")
+    return entry
+
+
+def load_completed(
+    path: Path,
+    *,
+    run_config: dict[str, Any],
+) -> dict[str, RepoResult]:
+    if not path.is_file():
+        return {}
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+        if value.get("run_config") != run_config:
+            raise RuntimeError(
+                f"{path}: existing results use different benchmark parameters"
+            )
+        return {
+            item["repo"]: RepoResult(
+                repo=item["repo"],
+                language=item["language"],
+                queries=int(item["queries"]),
+                ndcg10=float(item["ndcg10"]),
+                p50_ms=float(item["p50_ms"]),
+                files=int(item["files"]),
+                chunks=int(item["chunks"]),
+                tokens=int(item["tokens"]),
+                segments=int(item["segments"]),
+                index_ms=float(item.get("index_ms", 0.0)),
+                multisegment_queries=int(item.get("multisegment_queries", 0)),
+                oneshot_passes=int(item.get("oneshot_passes", 0)),
+                by_category={
+                    key: float(score)
+                    for key, score in item.get("by_category", {}).items()
+                },
+            )
+            for item in value.get("repos", [])
+        }
+    except RuntimeError:
+        raise
+    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
+        return {}
+
+
+def load_baseline(path: Path) -> dict[str, float]:
+    if not path.is_file():
+        return {}
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        return {}
+    return {
+        item["repo"]: float(item["ndcg10"])
+        for item in value.get("repos", [])
+        if isinstance(item, dict) and "repo" in item and "ndcg10" in item
+    }
+
+
+def summary(
+    results: list[RepoResult],
+    *,
+    run_config: dict[str, Any],
+    baseline: dict[str, float],
+) -> dict[str, Any]:
+    category_values: dict[str, list[float]] = defaultdict(list)
+    language_results: dict[str, list[RepoResult]] = defaultdict(list)
+    for result in results:
+        language_results[result.language].append(result)
+        for category, score in result.by_category.items():
+            category_values[category].append(score)
+    payload: dict[str, Any] = {
+        "tool": "attemory-code",
+        "run_config": run_config,
+        "repos": [asdict(result) for result in sorted(results, key=lambda item: item.repo)],
+        "repo_count": len(results),
+        "query_count": sum(item.queries for item in results),
+        "avg_ndcg10": round(sum(item.ndcg10 for item in results) / len(results), 4),
+        "avg_p50_ms": round(sum(item.p50_ms for item in results) / len(results), 1),
+        "avg_index_ms": round(sum(item.index_ms for item in results) / len(results), 1),
+        "multisegment_queries": sum(
+            item.multisegment_queries for item in results
+        ),
+        "oneshot_passes": sum(item.oneshot_passes for item in results),
+        "by_language": {
+            language: {
+                "repos": len(items),
+                "queries": sum(item.queries for item in items),
+                "ndcg10": round(
+                    sum(item.ndcg10 for item in items) / len(items), 4
+                ),
+            }
+            for language, items in sorted(language_results.items())
+        },
+        "by_category": {
+            category: round(sum(values) / len(values), 4)
+            for category, values in sorted(category_values.items())
+        },
+    }
+    comparable = [item for item in results if item.repo in baseline]
+    if comparable:
+        baseline_avg = sum(baseline[item.repo] for item in comparable) / len(
+            comparable
+        )
+        current_avg = sum(item.ndcg10 for item in comparable) / len(comparable)
+        payload["baseline_comparison"] = {
+            "repos": len(comparable),
+            "baseline_avg_ndcg10": round(baseline_avg, 4),
+            "current_avg_ndcg10": round(current_avg, 4),
+            "delta_ndcg10": round(current_avg - baseline_avg, 4),
+            "per_repo_delta": {
+                item.repo: round(item.ndcg10 - baseline[item.repo], 4)
+                for item in sorted(comparable, key=lambda value: value.repo)
+            },
+        }
+    return payload
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Evaluate prebuilt attemory code indexes on Semble."
+    )
+    parser.add_argument("--semble-root", type=Path, default=DEFAULT_SEMBLE_ROOT)
+    parser.add_argument("--repo", action="append", default=[])
+    parser.add_argument("--language", action="append", default=[])
+    parser.add_argument("--host", default=os.environ.get("ATTEMORY_HOST", "127.0.0.1"))
+    parser.add_argument(
+        "--port",
+        type=int,
+        default=int(os.environ.get("ATTEMORY_PORT", "9006")),
+    )
+    parser.add_argument(
+        "--timeout",
+        type=float,
+        default=float(os.environ.get("ATTEMORY_TIMEOUT", "3600")),
+    )
+    parser.add_argument("--top-k", type=int, default=DEFAULT_TOP_K)
+    parser.add_argument("--search-top-k", type=int, default=DEFAULT_SEARCH_TOP_K)
+    parser.add_argument("--latency-runs", type=int, default=1)
+    parser.add_argument(
+        "--file-aggregation",
+        choices=("sum", "capped", "first"),
+        default="sum",
+    )
+    parser.add_argument(
+        "--no-oneshot-rerank",
+        dest="oneshot_rerank",
+        action="store_false",
+        default=True,
+    )
+    parser.add_argument("--index-manifest", type=Path, default=DEFAULT_INDEX_MANIFEST)
+    parser.add_argument(
+        "--baseline-results",
+        type=Path,
+        default=DEFAULT_BASELINE_RESULTS,
+    )
+    parser.add_argument("--output", type=Path, default=DEFAULT_RESULTS)
+    parser.add_argument("--verbose", action="store_true")
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    if args.top_k <= 0 or args.search_top_k <= 0 or args.latency_runs <= 0:
+        raise RuntimeError("top-k and latency values must be positive")
+
+    import_attemory()
+    from attemory import AttemoryClient
+
+    data = load_semble_data(args.semble_root)
+    specs, repo_tasks = selected_repos(
+        data,
+        repos=args.repo or None,
+        languages=args.language or None,
+    )
+    output = args.output.expanduser()
+    index_manifest = load_index_manifest(args.index_manifest.expanduser())
+    run_config = {
+        "top_k": args.top_k,
+        "search_top_k": args.search_top_k,
+        "latency_runs": args.latency_runs,
+        "file_aggregation": args.file_aggregation,
+        "oneshot_rerank": args.oneshot_rerank,
+        "index_profile": index_manifest.get("profile", "unknown"),
+        "attemory_version": index_manifest.get("attemory_version", "unknown"),
+        "attemory_git_commit": index_manifest.get(
+            "attemory_git_commit", "unknown"
+        ),
+        "attemory_git_dirty": bool(
+            index_manifest.get("attemory_git_dirty", False)
+        ),
+    }
+    completed = load_completed(output, run_config=run_config)
+    baseline = load_baseline(args.baseline_results.expanduser())
+    results = [result for repo, result in completed.items() if repo in repo_tasks]
+    client = AttemoryClient(host=args.host, port=args.port, timeout=args.timeout)
+
+    for repo, tasks in sorted(repo_tasks.items()):
+        if repo in completed:
+            print(f"{repo}: reused completed result", file=sys.stderr)
+            continue
+        spec = specs[repo]
+        verify_repo_revision(spec)
+        index = load_index(spec.benchmark_dir.resolve())
+        manifest_entry = validate_manifest_entry(
+            repo=repo,
+            spec=spec,
+            index=index,
+            manifest=index_manifest,
+        )
+        (
+            ndcg10,
+            p50_ms,
+            by_category,
+            multisegment_queries,
+            oneshot_passes,
+        ) = evaluate_repo(
+            tasks,
+            index=index,
+            client=client,
+            search_top_k=args.search_top_k,
+            top_k=args.top_k,
+            aggregation=args.file_aggregation,
+            oneshot_rerank=args.oneshot_rerank,
+            latency_runs=args.latency_runs,
+            verbose=args.verbose,
+        )
+        result = RepoResult(
+            repo=repo,
+            language=spec.language,
+            queries=len(tasks),
+            ndcg10=ndcg10,
+            p50_ms=p50_ms,
+            files=index.file_count,
+            chunks=index.chunk_count,
+            tokens=index.token_count,
+            segments=index.segment_count,
+            index_ms=float(manifest_entry.get("index_ms", 0.0)),
+            multisegment_queries=multisegment_queries,
+            oneshot_passes=oneshot_passes,
+            by_category=by_category,
+        )
+        results.append(result)
+        write_json_atomic(
+            output,
+            summary(results, run_config=run_config, baseline=baseline),
+        )
+        print(
+            f"{repo}: chunks={index.chunk_count} segments={index.segment_count} "
+            f"ndcg@10={ndcg10:.4f} p50_ms={p50_ms:.1f} "
+            f"multisegment_queries={multisegment_queries} "
+            f"oneshot_passes={oneshot_passes}",
+            file=sys.stderr,
+        )
+
+    if results:
+        payload = summary(
+            results,
+            run_config=run_config,
+            baseline=baseline,
+        )
+        write_json_atomic(output, payload)
+        print(json.dumps(payload, ensure_ascii=False, indent=2))
+        print(f"results saved to {output}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
