# Python build/cache output
__pycache__/
*.py[cod]
*.egg-info/
.pybuild/
.pytest_cache/
.venv/

# Default ATMCORE SDK
3rd/attemory-core*

# Native/CMake build output
build*/

# Wheel/package output
dist/
*.whl
package_testing/

# Pinned upstream benchmark checkouts created by benchmarks/prepare_bench.sh
benchmarks/LongMemEval/
benchmarks/EverOS/
benchmarks/semble/
benchmarks/SWE-QA-Bench/
benchmarks/results/semble/runs/
publish/

# Runtime package payloads generated by packaging/collect_runtime.py
packaging/runtime-*/python/*/bin/*
packaging/runtime-*/python/*/lib/*
packaging/runtime-*/python/*/metadata/build-info.json
